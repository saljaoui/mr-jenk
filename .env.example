COMPOSE_PROJECT_NAME=buy01


MONGO_USER=appuser
MONGO_PASSWORD=apppass
MONGO_DB_ROOT=buy01
MONGO_IMAGE=mongo:8

# Per-service DB names
MONGO_DB_PRODUCTS=buy01_products
MONGO_DB_USERS=buy01_users
MONGO_DB_MEDIA=buy01_media


KAFKA_INTERNAL_PORT=9092
KAFKA_HOST_PORT=9092
KAFKA_IMAGE=confluentinc/cp-kafka:7.6.0
KAFKA_CLUSTER_ID=sDb4S423Qae3VIPSnFELjg
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:${KAFKA_INTERNAL_PORT},CONTROLLER://0.0.0.0:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:${KAFKA_INTERNAL_PORT}
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1


DISCOVERY_SERVER_PORT=8761
DISCOVERY_IMAGE_NAME=discovery-service

API_GATEWAY_SERVER_PORT=8080
API_GATEWAY_IMAGE_NAME=api-gateway

PRODUCT_SERVER_PORT=8081
PRODUCT_MONGODB_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongo:27017/${MONGO_DB_PRODUCTS}?authSource=admin
PRODUCT_EUREKA_DEFAULT_ZONE=http://discovery:${DISCOVERY_SERVER_PORT}/eureka/
PRODUCT_JWT_SECRET=4fd8a6c3b92f4a8c9c6b8a1f2e3d4c5f6a7b8c9d
PRODUCT_SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:${KAFKA_INTERNAL_PORT}


USER_SERVER_PORT=8082
USER_MONGODB_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongo:27017/${MONGO_DB_USERS}?authSource=admin
USER_EUREKA_DEFAULT_ZONE=http://discovery:${DISCOVERY_SERVER_PORT}/eureka/
USER_JWT_SECRET=4fd8a6c3b92f4a8c9c6b8a1f2e3d4c5f6a7b8c9d
USER_SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:${KAFKA_INTERNAL_PORT}


MEDIA_SERVER_PORT=8083
MEDIA_MONGODB_URI=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@mongo:27017/${MONGO_DB_MEDIA}?authSource=admin
MEDIA_EUREKA_DEFAULT_ZONE=http://discovery:${DISCOVERY_SERVER_PORT}/eureka/
MEDIA_SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:${KAFKA_INTERNAL_PORT}
MEDIA_JWT_SECRET=4fd8a6c3b92f4a8c

FRONTEND_HOST_PORT=80
HOST_BIND_IP=127.0.0.1
FRONTEND_IMAGE_NAME=frontend
